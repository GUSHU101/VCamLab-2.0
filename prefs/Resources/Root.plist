            <key>label</key>
            <string>VirtualCamPro</string>
            <key>footerText</key>
            <string>支持 HLS（.m3u8）和 MJPEG（HTTP/HTTPS）。方向或镜像只在手机与 OBS 其中一端设置，避免重复变换。手机解码目标支持 1–240 FPS，屏幕预览仍受设备物理刷新率限制；1920 适合 iPhone 7 Plus。</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.murkaska.virtualcampro</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>启用画面替换</string>
