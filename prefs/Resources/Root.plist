<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>VirtualCamPro</string>
            <key>footerText</key>
            <string>网络流严格采用发送端的像素方向、分辨率、质量和帧率，不在手机上再次旋转、镜像、限帧或降质；网络流始终保留手机原生麦克风。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><false/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>enabled</string>
            <key>label</key><string>启用系统摄像头替换</string>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>运行状态与恢复</string>
            <key>footerText</key><string>来源状态反映 SpringBoard 是否持续产帧；系统视频管线仅在相机应用实际请求采集时才会显示 mediaserverd 活跃。状态是诊断信息，不作为关闭应用层逐样本 fallback 的全局门控。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>当前来源</string>
            <key>get</key><string>currentSourceRuntimeStatus:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>系统视频管线</string>
            <key>get</key><string>currentSystemVideoPipelineStatus:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>重载当前来源</string>
            <key>action</key><string>reloadCurrentSource:</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>0</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>sourceType</string>
            <key>label</key><string>替换来源</string>
            <key>validTitles</key>
            <array>
                <string>网络 HLS / MJPEG</string>
                <string>设备屏幕实时镜像</string>
                <string>手机本地视频 / 音频</string>
            </array>
            <key>validValues</key>
            <array><integer>0</integer><integer>1</integer><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>网络流</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
            <key>footerText</key><string>推荐使用 MJPEG 获得最低延迟。手机只解码发送端完整帧，所有画面参数由 Windows/OBS 发送端决定。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>default</key><string></string>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>streamURL</string>
            <key>label</key><string>网络流 URL</string>
            <key>placeholder</key><string>http://192.168.1.10:8888/live.mjpg</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>检测当前网络流</string>
            <key>action</key><string>testStreamConnection:</string>
            <key>vcSourceTypes</key><array><integer>0</integer></array>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>屏幕镜像</string>
            <key>vcSourceTypes</key><array><integer>1</integer></array>
            <key>footerText</key><string>屏幕来源按设备显示方向和系统刷新节奏直接输出，不使用本地视频的旋转、镜像、质量或帧率设置。</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>手机本地媒体</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>footerText</key><string>可从“文件”批量选择视频/音频，也可从“照片”一次选择多段视频。所选媒体会复制到 /var/mobile/Media/VirtualCamPro/；目录中至少有 2 段视频时，播放期间按音量加/减切换下一段/上一段。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>选择本地视频 / 音频</string>
            <key>action</key><string>chooseLocalMedia:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>localMediaPath</string>
            <key>label</key><string>当前媒体</string>
            <key>get</key><string>currentLocalMediaName:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>音量键播放列表</string>
            <key>get</key><string>currentLocalVideoPlaylistSummary:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>音量键 Hook 状态</string>
            <key>get</key><string>currentLocalVolumeHookStatus:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>SpringBoard 变换状态</string>
            <key>get</key><string>currentLocalTransformStatus:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>清除当前媒体选择</string>
            <key>action</key><string>clearLocalMedia:</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>loopLocalMedia</string>
            <key>label</key><string>循环播放当前本地媒体</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><integer>60</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>preferredFPS</string>
            <key>label</key><string>本地视频最高 FPS</string>
            <key>min</key><integer>1</integer>
            <key>max</key><integer>240</integer>
            <key>showValue</key><true/>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>1920</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>maximumPixelDimension</string>
            <key>label</key><string>本地视频解码质量</string>
            <key>validTitles</key>
            <array>
                <string>1280（省电）</string><string>1920（推荐）</string>
                <string>2560（高清）</string><string>3840（超清）</string>
            </array>
            <key>validValues</key>
            <array><integer>1280</integer><integer>1920</integer><integer>2560</integer><integer>3840</integer></array>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkListCell</string>
            <key>detail</key><string>PSListItemsController</string>
            <key>default</key><integer>0</integer>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>sourceRotation</string>
            <key>label</key><string>本地视频旋转</string>
            <key>validTitles</key>
            <array><string>不旋转</string><string>顺时针 90°</string><string>旋转 180°</string><string>逆时针 90°</string></array>
            <key>validValues</key>
            <array><integer>0</integer><integer>90</integer><integer>180</integer><integer>270</integer></array>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><false/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>mirrorSource</string>
            <key>label</key><string>水平镜像本地视频</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>aspectFill</string>
            <key>label</key><string>本地视频填满画面</string>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><real>1.0</real>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>jpegQuality</string>
            <key>label</key><string>本地画面拍照 JPEG 质量</string>
            <key>min</key><real>0.5</real>
            <key>max</key><real>1.0</real>
            <key>showValue</key><true/>
            <key>vcSourceTypes</key><array><integer>2</integer></array>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>稳定性</string>
            <key>footerText</key><string>断流保护仅决定替换帧过期后的行为；任何解码或私有节点失败都保持原相机/麦克风路径。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>holdLastFrame</string>
            <key>label</key><string>断流后保持最后一帧</string>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>default</key><real>8.0</real>
            <key>defaults</key><string>com.murkaska.virtualcampro</string>
            <key>key</key><string>staleFrameTimeout</string>
            <key>label</key><string>旧帧超时（秒）</string>
            <key>min</key><real>2.0</real>
            <key>max</key><real>30.0</real>
            <key>showValue</key><true/>
            <key>PostNotification</key><string>com.murkaska.virtualcampro/preferences.changed</string>
        </dict>
    </array>
    <key>title</key><string>VirtualCamPro</string>
</dict>
</plist>
