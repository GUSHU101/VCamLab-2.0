* text=auto
*.sh text eol=lf
layout/DEBIAN/* text eol=lf
*.plist text eol=lf
*.m text eol=lf
*.h text eol=lf
*.x text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.deb binary

# The standalone companion carries a byte-for-byte SHA-256 manifest. Disable
# checkout-time newline conversion for that subtree so Windows and Linux
# runners verify the exact committed payload bytes.
VirtualCamPro-Windows-Control-Center/** -text
